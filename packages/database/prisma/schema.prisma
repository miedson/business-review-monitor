generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  tenants      TenantUser[]

  @@map("users")
}

model Tenant {
  id                   String               @id @default(cuid())
  name                 String
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  businessLocations    BusinessLocation[]
  googleConnections    GoogleConnection[]
  instagramComments    InstagramComment[]
  instagramCommentReplies InstagramCommentReply[]
  instagramMedia       InstagramMedia[]
  instagramExternalUsers InstagramExternalUser[]
  instagramConnections InstagramConnection[]
  instagramConversations InstagramConversation[]
  instagramMessages    InstagramMessage[]
  reviewCaches         ReviewCache[]
  users                TenantUser[]

  @@map("tenants")
}

model TenantUser {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      TenantUserRole @default(OWNER)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_users")
}

model GoogleConnection {
  id                    String                 @id @default(cuid())
  tenantId              String
  googleAccountEmail    String?
  googleAccountId       String?
  encryptedRefreshToken String?
  scope                 String
  status                GoogleConnectionStatus @default(DISCONNECTED)
  connectedAt           DateTime?              @db.Timestamptz(3)
  disconnectedAt        DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  businessLocations     BusinessLocation[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("google_connections")
}

model InstagramConnection {
  id                              String                    @id @default(cuid())
  tenantId                        String                    @unique
  instagramUserId                 String
  instagramProfessionalAccountId  String?                   @unique
  username                        String?
  accountType                     String?
  encryptedAccessToken            String?
  scope                           String
  status                          InstagramConnectionStatus @default(DISCONNECTED)
  connectedAt                     DateTime?                 @db.Timestamptz(3)
  disconnectedAt                  DateTime?                 @db.Timestamptz(3)
  tokenExpiresAt                  DateTime?                 @db.Timestamptz(3)
  createdAt                       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                  @updatedAt @db.Timestamptz(3)
  comments                        InstagramComment[]
  media                           InstagramMedia[]
  externalUsers                   InstagramExternalUser[]
  conversations                   InstagramConversation[]
  tenant                          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([instagramProfessionalAccountId])
  @@map("instagram_connections")
}

model InstagramComment {
  id                    String                 @id @default(cuid())
  tenantId              String
  instagramConnectionId String
  externalCommentId     String
  externalMediaId       String?
  authorExternalId      String?
  authorUsername        String?
  text                  String?
  createdAtExternal     DateTime?              @db.Timestamptz(3)
  status                InstagramCommentStatus @default(NEW)
  readAt                DateTime?              @db.Timestamptz(3)
  repliedAt             DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  instagramConnection   InstagramConnection    @relation(fields: [instagramConnectionId], references: [id], onDelete: Cascade)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  replies               InstagramCommentReply[]

  @@unique([instagramConnectionId, externalCommentId])
  @@index([tenantId])
  @@index([instagramConnectionId])
  @@index([createdAtExternal])
  @@map("instagram_comments")
}

model InstagramCommentReply {
  id                 String    @id @default(cuid())
  tenantId           String
  instagramCommentId String
  externalReplyId    String?
  authorType         InstagramReplyAuthorType
  text               String
  createdAtExternal  DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instagramComment   InstagramComment @relation(fields: [instagramCommentId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@index([instagramCommentId])
  @@map("instagram_comment_replies")
}

model InstagramMedia {
  id                    String    @id @default(cuid())
  tenantId              String
  instagramConnectionId String
  externalMediaId       String
  mediaType             String?
  mediaProductType      String?
  caption               String?
  mediaUrl              String?
  thumbnailUrl          String?
  permalink             String?
  publishedAt           DateTime? @db.Timestamptz(3)
  lastSyncedAt          DateTime  @default(now()) @db.Timestamptz(3)
  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instagramConnection   InstagramConnection @relation(fields: [instagramConnectionId], references: [id], onDelete: Cascade)
  @@unique([instagramConnectionId, externalMediaId])
  @@index([tenantId])
  @@map("instagram_media")
}

model InstagramExternalUser {
  id                    String    @id @default(cuid())
  tenantId              String
  instagramConnectionId String
  externalUserId        String
  username              String?
  name                  String?
  profilePictureUrl     String?
  lastSyncedAt          DateTime  @default(now())
  tenant                Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instagramConnection   InstagramConnection @relation(fields: [instagramConnectionId], references: [id], onDelete: Cascade)
  @@unique([instagramConnectionId, externalUserId])
  @@index([tenantId])
  @@map("instagram_external_users")
}

model InstagramConversation {
  id                          String                        @id @default(cuid())
  tenantId                    String
  instagramConnectionId       String
  participantExternalId       String
  participantUsername         String?
  participantName             String?
  participantProfilePictureUrl String?
  lastMessageAt               DateTime?                     @db.Timestamptz(3)
  lastMessagePreview          String?
  unreadCount                 Int                           @default(0)
  createdAt                   DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                      @updatedAt @db.Timestamptz(3)
  messages                    InstagramMessage[]
  instagramConnection         InstagramConnection           @relation(fields: [instagramConnectionId], references: [id], onDelete: Cascade)
  tenant                      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([instagramConnectionId, participantExternalId])
  @@index([tenantId])
  @@index([instagramConnectionId])
  @@index([lastMessageAt])
  @@map("instagram_conversations")
}

model InstagramMessage {
  id                      String                    @id @default(cuid())
  tenantId                String
  instagramConversationId String
  externalMessageId       String
  senderExternalId        String
  recipientExternalId     String
  direction               InstagramMessageDirection
  text                    String?
  sentAtExternal          DateTime?                 @db.Timestamptz(3)
  status                  InstagramMessageStatus    @default(DELIVERED)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)
  instagramConversation   InstagramConversation     @relation(fields: [instagramConversationId], references: [id], onDelete: Cascade)
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([instagramConversationId, externalMessageId])
  @@index([tenantId])
  @@index([instagramConversationId])
  @@index([sentAtExternal])
  @@map("instagram_messages")
}

model BusinessLocation {
  id                 String           @id @default(cuid())
  tenantId           String
  googleConnectionId String
  googleAccountId    String
  googleLocationId   String
  name               String
  storeCode          String?
  isSelected         Boolean          @default(false)
  isActive           Boolean          @default(true)
  lastSyncedAt       DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  googleConnection   GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewCaches       ReviewCache[]

  @@unique([googleConnectionId, googleLocationId])
  @@index([tenantId])
  @@index([googleConnectionId])
  @@index([isSelected])
  @@map("business_locations")
}

model ReviewCache {
  id                 String           @id @default(cuid())
  tenantId           String
  businessLocationId String
  googleReviewId     String
  reviewerName       String?
  starRating         Int
  comment            String?
  reviewCreatedAt    DateTime         @db.Timestamptz(3)
  reviewUpdatedAt    DateTime         @db.Timestamptz(3)
  replyText          String?
  replyUpdatedAt     DateTime?        @db.Timestamptz(3)
  cachedAt           DateTime         @db.Timestamptz(3)
  expiresAt          DateTime         @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  businessLocation   BusinessLocation @relation(fields: [businessLocationId], references: [id], onDelete: Cascade)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([businessLocationId, googleReviewId])
  @@index([tenantId])
  @@index([businessLocationId])
  @@index([expiresAt])
  @@map("review_cache")
}

enum TenantUserRole {
  OWNER
  ADMIN
  MEMBER
}

enum GoogleConnectionStatus {
  CONNECTED
  DISCONNECTED
  REAUTH_REQUIRED
  ERROR
}

enum InstagramConnectionStatus {
  CONNECTED
  DISCONNECTED
  REAUTH_REQUIRED
  ERROR
}

enum InstagramCommentStatus {
  NEW
  READ
}

enum InstagramReplyAuthorType {
  CUSTOMER
  BUSINESS
}

enum InstagramMessageDirection {
  INBOUND
  OUTBOUND
}

enum InstagramMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}
