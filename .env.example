NODE_ENV=development

# Application URLs.
WEB_URL=http://localhost:3000
API_URL=http://localhost:3333

# Development database.
POSTGRES_DB=business_review_monitor
POSTGRES_USER=brm
POSTGRES_PASSWORD=brm_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brm:brm_dev_password@127.0.0.1:5432/business_review_monitor

# Development Redis.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
BRM_QUEUE_PREFIX=brm

# Production-only Redis password for Coolify/private network deployments.
REDIS_PASSWORD=change-me

# SaaS authentication. Replace in real environments.
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters

# OAuth token encryption key. Must be 32 bytes encoded as base64.
# Example generation: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=

# Google OAuth / Business Profile integration.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3333/integrations/google/callback
GOOGLE_PROVIDER=mock
